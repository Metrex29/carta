# Cabeceras globales de seguridad y privacidad para Cloudflare Pages
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  X-Robots-Tag: noindex, nofollow
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# Caché corta para HTML, CSS y JS (permite ver cambios de texto/configuración rápidamente)
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/carta.html
  Cache-Control: public, max-age=0, must-revalidate

/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/js/*
  Cache-Control: public, max-age=3600, must-revalidate

# Caché larga (1 año) para recursos multimedia (fotos, vídeos y música)
/fotos/*
  Cache-Control: public, max-age=31536000, immutable

/videos/*
  Cache-Control: public, max-age=31536000, immutable

/musica/*
  Cache-Control: public, max-age=31536000, immutable
